# Скопируйте в .env (он в .gitignore) и заполните только то, что нужно.
# Docker Compose подхватывает .env из корня автоматически; значения читает только backend.
# Для cached_snapshot (по умолчанию) ключи не нужны.

# cached_snapshot — показать проверенный результат из demo/result без внешних вызовов;
# live — выполнить настоящий анализ произвольного запроса (тратит квоты платных API).
NEXTWAVE_ANALYSIS_MODE=cached_snapshot
# Дата отсечения. live принимает только 2026-09-15 (LABELING_CUTOFF_DATE), другое значение — ошибка job.
NEXTWAVE_ANALYSIS_CUTOFF=2026-09-15

# Пароль PostgreSQL для compose; по умолчанию nextwave-local. Только URL-safe символы.
NEXTWAVE_POSTGRES_PASSWORD=

# --- Обязательно для live -------------------------------------------------
# LLM (Candidate Gate, извлечение кандидатов, Evidence); провайдер openai задан в config/hackathon.env.
NEXTWAVE_OPENAI_API_KEY=
# Exa: отраслевое обогащение всех принятых кандидатов.
NEXTWAVE_EXA_API_KEY=

# --- Необязательно --------------------------------------------------------
# OpenAlex: без ключа анонимный доступ с меньшей квотой (mailto задан в config/hackathon.env).
NEXTWAVE_OPENALEX_API_KEY=
# Media Cloud: без ключа первичный поиск новостей автоматически идёт через GDELT.
NEXTWAVE_MEDIACLOUD_API_KEY=
# Нужен, только если NEXTWAVE_LLM_PROVIDER не openai (yandex/qwen/gigachat); для openai не читается.
NEXTWAVE_LLM_API_KEY=
